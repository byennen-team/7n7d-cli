{
  "name": "@7n7d/cli",
  "version": "0.1.0",
  "description": "Terminal CLI for the 7N7D DeFi protocol",
  "type": "module",
  "bin": {
    "7n7d": "./dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsx src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "verify:publishable": "node scripts/verify-publishable.mjs",
    "prepublishOnly": "npm run verify:publishable",
    "prepack": "node scripts/prepare-release-manifest.mjs",
    "postpack": "node scripts/restore-release-manifest.mjs"
  },
  "dependencies": {
    "chalk": "^5.3.0",
    "commander": "^12.1.0",
    "dotenv": "^16.4.5",
    "inquirer": "^9.2.23",
    "ora": "^8.0.1",
    "viem": "^2.21.0"
  },
  "devDependencies": {
    "@7n7d/sdk": "file:../7n7d-sdk",
    "@types/inquirer": "^9.0.7",
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^4.1.12",
    "tsup": "^8.2.0",
    "tsx": "^4.19.0",
    "typescript": "^5.5.0",
    "vitest": "^4.1.12"
  },
  "license": "MIT",
  "overrides": {
    "esbuild": "^0.28.1"
  }
}
